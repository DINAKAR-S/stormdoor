# Copy to .env. Everything here is optional: the defaults run the whole
# gateway with no infrastructure and no API keys, against the local echo model.

# ── server ───────────────────────────────────────────────────────────────
# STORMDOOR_HOST=127.0.0.1
# STORMDOOR_PORT=8080
# STORMDOOR_LOG_LEVEL=info

# ── storage ──────────────────────────────────────────────────────────────
# STORMDOOR_DB_PATH=./stormdoor.db

# ── admin plane ──────────────────────────────────────────────────────────
# Guards /admin/*. Generated and logged once per process if left unset.
# STORMDOOR_ADMIN_TOKEN=

# ── rate limiting ────────────────────────────────────────────────────────
# memory is correct for one replica. Use redis for more than one.
# STORMDOOR_LIMITER_BACKEND=memory
# STORMDOOR_REDIS_URL=redis://localhost:6379/0

# ── providers ────────────────────────────────────────────────────────────
# Left unset, the Anthropic SDK resolves credentials itself from
# ANTHROPIC_API_KEY or an `ant auth login` profile.
# STORMDOOR_ANTHROPIC_API_KEY=
# STORMDOOR_OPENAI_API_KEY=
# Point at any OpenAI-compatible server: vLLM, Ollama, Groq, Together.
# STORMDOOR_OPENAI_BASE_URL=

# Sent upstream when the caller omits max_tokens. Raising it makes worst-case
# budget admission stricter, because the estimate prices this ceiling.
# STORMDOOR_DEFAULT_MAX_TOKENS=4096
# STORMDOOR_REQUEST_TIMEOUT_S=120

# ── routing, retries and circuit breaking ──────────────────────────
# JSON file mapping a model name to an ordered list of targets to try. Without
# it, a model name means itself and there is nothing to fall back to.
# STORMDOOR_ROUTES_FILE=./routes.json

# Off means try only the first target. Useful for measuring what failover is
# worth, which is what bench/harness.py does.
# STORMDOOR_FAILOVER_ENABLED=true

# Retries against one target before the chain moves on. Only retryable failures
# are retried: a 400 fails immediately everywhere.
# STORMDOOR_MAX_RETRIES=2
# STORMDOOR_RETRY_BASE_DELAY_S=0.2
# STORMDOOR_RETRY_MAX_DELAY_S=5

# Consecutive retryable failures before a target is skipped, and how long it is
# skipped for before one probe is allowed through.
# STORMDOOR_BREAKER_FAILURE_THRESHOLD=3
# STORMDOOR_BREAKER_COOLDOWN_S=30

# ── failure injection ────────────────────────────────────────────────────
# Off by default. While off, the X-Stormdoor-Chaos header is ignored entirely.
# STORMDOOR_CHAOS_ENABLED=false
# STORMDOOR_CHAOS_DEFAULT=fault=error;status=503;p=0.05;seed=7

# ── pricing ──────────────────────────────────────────────────────────────
# JSON rate card that overrides or extends the built-in table. Unpriced models
# are recorded at $0.00 and flagged, never guessed.
# STORMDOOR_PRICING_FILE=./pricing.json
